# =================================================================
# FLASK CORE CONFIGURATION
# =================================================================
SECRET_KEY=your_secret_key_here
STAFF_PASSWORD=your_staff_password_here
HCT_PASSWORD=your_hct_password_here

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# IMPORTANT: DATABASE_URL is required in production!
#
# For LOCAL DEVELOPMENT (SQLite):
# DATABASE_URL=sqlite:///instance/taskforce.db
#
# For PRODUCTION (Supabase/PostgreSQL):
# Get this from: Supabase Dashboard > Settings > Database > Connection String > URI
# Then use the format with psycopg2 driver:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
#
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:abc123def456@db.xyz789abc.supabase.co:5432/postgres
#
DATABASE_URL=

# =================================================================
# ROBLOX API CONFIGURATION
# =================================================================
# Get your group ID from your Roblox group URL: https://www.roblox.com/groups/{GROUP_ID}/
ROBLOX_GROUP_ID=

# Get this cookie from your bot account:
# 1. Log into the bot account in browser
# 2. Open Developer Tools (F12) → Application → Cookies → https://www.roblox.com
# 3. Copy the .ROBLOSECURITY cookie value (it's very long)
ROBLOX_COOKIE=

# Enable/disable Roblox background sync (set to 'true' to enable)
ROBLOX_SYNC_ENABLED=false
ROBLOX_BACKGROUND_SYNC_ENABLED=false

# Sync interval in seconds (3600 = 1 hour)
ROBLOX_SYNC_INTERVAL=3600

# =================================================================
# DISCORD BOT API CONFIGURATION
# =================================================================
# Generate a secure API key with: python generate_api_key.py
DISCORD_BOT_API_KEY=

# API rate limiting (requests per minute)
API_RATE_LIMIT=100

# Enable detailed API logging
API_ENABLE_LOGGING=true

# =================================================================
# DISCORD NOTIFICATIONS
# =================================================================
# Discord webhook for notifications to cortex-notis channel
# Get from: Discord Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_NOTIFICATION_WEBHOOK_URL=
